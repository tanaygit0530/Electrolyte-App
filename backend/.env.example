# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Secret (Must be at least 32 characters, 256-bit cryptographically secure string in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=12h
ADMIN_JWT_EXPIRES_IN=12h

# Cloudinary (Media / Invoice PDF Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer / Resend)
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password
RESEND_API_KEY=re_your_resend_api_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# NeonDB Cloud PostgreSQL Connection URL
# Example: postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Security Overrides (Optional)
# Set to 'false' only in local debug/testing if CA verification is problematic
DB_SSL_REJECT_UNAUTHORIZED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://admin.electrolyte.app
